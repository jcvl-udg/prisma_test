generator client {
  provider            = "prisma-client"
  output              = "./generated"
  importFileExtension = "ts"
}

generator pothos {
  provider          = "prisma-pothos-types"
  clientOutput      = "../prisma/generated/"
  output            = "../lib/pothos-prisma-types.ts"
  generateDatamodel = "true"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// 1. GESTIÓN DE USUARIOS (Mantenemos la base)
// ------------------------------------------------------

model User {
  id      Int      @id @default(autoincrement())
  email   String   @unique
  name    String?
  profile Profile?

  bookings Booking[]
}

model Booking {
  id        String   @id @default(cuid())
  userId    Int? // Opcional para checkout de invitados
  user      User?    @relation(fields: [userId], references: [id])
  status    String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  createdAt DateTime @default(now())

  items BookingItem[]
}

model BookingItem {
  id String @id @default(cuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id])

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])
}

model Profile {
  id     Int     @id @default(autoincrement())
  bio    String?
  userId Int     @unique
  user   User    @relation(fields: [userId], references: [id])
}

// ------------------------------------------------------
// 2. MODELO CANÓNICO DE VIAJES (Nueva arquitectura)
// ------------------------------------------------------

model Destination {
  id     String  @id @default(cuid())
  name   String // Ej: "Cancún" o "Mallorca"
  code   String? // Ej: "CUN"
  hotels Hotel[]

  @@index([name]) // Optimiza búsqueda por nombre de destino
}

model Hotel {
  id            String @id @default(cuid())
  title         String // Nombre del hotel
  categoryStars Int // Estrellas (1-5)

  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])

  rooms            Room[]
  providerMappings ProviderMapping[]
  bookingItems     BookingItem[]

  @@index([title]) // Optimiza búsqueda por nombre de hotel
  @@index([categoryStars]) // Optimiza filtros de estrellas
  @@index([destinationId]) // Optimiza joins y filtrado por destino
}

model Room {
  id   String @id @default(cuid())
  name String // Ej: "Double Standard"

  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id])

  // Código de la habitación en el proveedor externo (opcional si es manual)
  externalRoomCode String?
  bookingItems     BookingItem[]
}

model ProviderMapping {
  id           String @id @default(cuid())
  providerName String // Ej: "HOTELBEDS", "LOCAL"
  externalId   String // El ID que usa el proveedor (Ej: "6930")

  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id])

  // Evita registrar el mismo hotel del mismo proveedor dos veces
  @@unique([providerName, externalId])
}
